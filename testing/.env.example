ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Optional: if set, the admin flow will advance one specific order to its next status.
ADMIN_ORDER_PROCESS_ID=

# Optional: if set, the admin flow will cancel one specific order.
ADMIN_ORDER_CANCEL_ID=

# Optional: override the base URL from config/site.json.
SITE_URL=
