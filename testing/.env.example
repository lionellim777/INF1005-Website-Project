ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Optional legacy override: target a specific real order instead of the default disposable order.
ADMIN_ORDER_PROCESS_ID=

# Optional legacy override: target a specific real order for cancellation instead of the default disposable order.
ADMIN_ORDER_CANCEL_ID=

# Optional: override the base URL from config/site.json.
SITE_URL=
