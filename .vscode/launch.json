    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        },
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 0,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ],
            "env": {
                "XDEBUG_MODE": "debug,develop",
                "XDEBUG_CONFIG": "client_port=${port}",
                "SUPPORT_SMTP_HOST": "smtp.gmail.com",
                "SUPPORT_SMTP_PORT": "587",
                "SUPPORT_SMTP_USER": "websys829@gmail.com",
                "SUPPORT_SMTP_PASS": "kjjjgmlcpgrntxwx",
                "SUPPORT_SMTP_ENCRYPTION": "tls",
                "SUPPORT_MAIL_FROM": "websys829@gmail.com",
                "SUPPORT_MAIL_FROM_NAME": "Pomegranate Support",
                "SUPPORT_REPLY_TO": "websys829@gmail.com",
                "SUPPORT_REPLY_TO_NAME": "Pomegranate Support",
                "SUPPORT_SMTP_DEBUG": "0"
            }
        },
        {
            "name": "Launch Built-in web server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-dxdebug.mode=debug",
                "-dxdebug.start_with_request=yes",
                "-S",
                "localhost:0"
            ],
            "program": "",
            "cwd": "${workspaceRoot}",
            "port": 9003,
            "env": {
                "SUPPORT_SMTP_HOST": "smtp.gmail.com",
                "SUPPORT_SMTP_PORT": "587",
                "SUPPORT_SMTP_USER": "websys829@gmail.com",
                "SUPPORT_SMTP_PASS": "kjjjgmlcpgrntxwx",
                "SUPPORT_SMTP_ENCRYPTION": "tls",
                "SUPPORT_MAIL_FROM": "websys829@gmail.com",
                "SUPPORT_MAIL_FROM_NAME": "Pomegranate Support",
                "SUPPORT_REPLY_TO": "websys829@gmail.com",
                "SUPPORT_REPLY_TO_NAME": "Pomegranate Support",
                "SUPPORT_SMTP_DEBUG": "0"
            },
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        }
    ]
}
